# Quest Studio local server settings
# Copy this file to .env for local-only settings.
# The local Node server loads .env through dotenv.

# Local server port used by `npm start`.
PORT=4177

# Steam Workshop preview lookups currently use Steam's public GetPublishedFileDetails endpoint
# and do not require or read a Steam Web API key.
# Keep this blank unless you add custom server code that explicitly needs it.
STEAM_API_KEY=

# Optional AI quest text brain. Used only by the local Node server, never by the browser.
# Copy .env.example to .env and put your real token in .env only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
